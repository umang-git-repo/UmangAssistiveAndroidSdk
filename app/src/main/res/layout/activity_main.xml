<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">
        <androidx.core.widget.NestedScrollView
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!--SpiceMoney-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_5dp"
                    android:gravity="center"
                    android:text="Spice Money SDK Demo"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_spice_staging_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Spice Money Staging Url"
                    android:importantForAccessibility="yes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <Button
                    android:id="@+id/bt_start_spice_money"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spice Money SDK"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginVertical="5dp"
                    android:background="@color/colorBlueLight" />
                <!--Rnfi-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_5dp"
                    android:gravity="center"
                    android:text="RNFI SDK Demo"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_rnfi_staging_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="RNFI Staging Url"
                    android:importantForAccessibility="yes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <Button
                    android:id="@+id/bt_start_rnfi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RNFI SDK"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginVertical="5dp"
                    android:background="@color/colorBlueLight" />

                <!--NSSO Login-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_5dp"
                    android:gravity="center"
                    android:text="NSSO SDK Demo"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_payload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="NSSO Payload"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_jwt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="NSSO JWT Token"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_payload" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_jwt_decrypted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="NSSO Decrypted Data"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_payload" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_nsso_staging_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="NSSO Staging Url"
                    android:importantForAccessibility="yes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <Button
                    android:id="@+id/bt_start_nsso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start NSSO SDK"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginVertical="5dp"
                    android:background="@color/colorBlueLight" />
                <!--BOI Login-->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_5dp"
                    android:gravity="center"
                    android:text="BOI SDK Demo"
                    android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_boi_staging_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BOI Staging Url"
                    android:importantForAccessibility="yes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_boi_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BOI User Mobile"
                    android:maxLength="10"
                    android:inputType="number"
                    android:importantForAccessibility="yes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/bt_start_boi_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start BOI Full Services SDK"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />
                <Button
                    android:id="@+id/bt_start_boi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start BOI Top Services SDK"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginVertical="5dp"
                    android:background="@color/colorBlueLight" />

                <Button
                    android:id="@+id/bt_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_jwt" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
